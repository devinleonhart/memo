{
  "name": "memo-discord-bot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "rm -rf ./dist && tsc -p tsconfig.build.json",
    "dev": "NODE_ENV=development tsx watch ./src/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc",
    "quality": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "quality:ci": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:coverage",
    "start": "NODE_ENV=production node ./dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@discordjs/builders": "^1.15.0",
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.10"
  },
  "devDependencies": {
    "@tsconfig/node26": "^26.0.2",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
