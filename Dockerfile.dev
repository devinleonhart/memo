FROM node:24.8.0-alpine3.21

WORKDIR /app
RUN corepack enable

COPY package.json pnpm-lock.yaml tsconfig.json nodemon.json eslint.config.js ./
RUN pnpm install --frozen-lockfile

COPY docker-entrypoint-dev.sh /app/docker-entrypoint-dev.sh
RUN chmod +x /app/docker-entrypoint-dev.sh

COPY ./src ./src

ENTRYPOINT ["/app/docker-entrypoint-dev.sh"]
CMD ["pnpm", "dev"]
